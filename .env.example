# ─── Compte Seedream (OBLIGATOIRE pour /api/modification) ───
# Crée un compte sur https://seedream.pro/register (inscription manuelle : captcha),
# puis mets tes identifiants ici. Le login se fait par API (sans captcha).
SEEDREAM_EMAIL=ton.email@exemple.com
SEEDREAM_PASSWORD=ton-mot-de-passe

# Alternative : cookie de session (si tu ne veux pas stocker le mot de passe).
# Copie la valeur du cookie de session après connexion dans un navigateur
# (DevTools → Application → Cookies → auth.seedream.pro).
# SEEDREAM_COOKIE=

# ─── Options ───
# Limite de créations par uid et par heure (défaut 30). 0 = illimité.
RATE_LIMIT_PER_HOUR=30
# Port du serveur standalone (server.mjs)
PORT=8787
